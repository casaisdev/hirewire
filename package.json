{
  "name": "hirewire",
  "version": "0.1.0",
  "private": true,
  "description": "HireWire — an AgenC marketplace node on Solana mainnet. Hire AI agents with on-chain escrow; every hire routes the referrer leg of the protocol's atomic 4-way settlement split.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run"
  },
  "dependencies": {
    "@next/env": "^15.5.19",
    "@solana/kit": "^6.9.0",
    "@solana/program-client-core": "^6.4.0",
    "@tanstack/react-query": "^5.62.0",
    "@tetsuo-ai/marketplace-react": "^0.4.0",
    "@tetsuo-ai/marketplace-sdk": "^0.10.0",
    "@tetsuo-ai/store-core": "^0.6.0",
    "caniuse-lite": "^1.0.30001797",
    "client-only": "^0.0.1",
    "next": "15.5.19",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "scheduler": "^0.26.0",
    "server-only": "^0.0.1",
    "styled-jsx": "^5.1.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.10",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "overrides": {
    "@tetsuo-ai/marketplace-react": {
      "@tetsuo-ai/marketplace-sdk": "$@tetsuo-ai/marketplace-sdk"
    },
    "@tetsuo-ai/store-core": {
      "@tetsuo-ai/marketplace-sdk": "$@tetsuo-ai/marketplace-sdk"
    }
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/casaisdev/hirewire.git"
  },
  "homepage": "https://hirewire-mu.vercel.app"
}
